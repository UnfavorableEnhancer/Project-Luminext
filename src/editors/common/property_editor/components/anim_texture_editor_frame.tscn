extends TextureButton

signal selected(frame_index : int, own_index : int)

var index : int = 0 : 
	set(value):
		index = clampi(value, 0, 99999999999)
		$Index.text = str(value)

var internal_index : int = 0


func set_texture(texture : Texture2D) -> void:
	texture_normal = texture

func _on_pressed() -> void:
	selected.emit(index, internal_index)
"

